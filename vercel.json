{
  "crons": [
    {
      "path": "/api/jobs/sync-matches?mode=scheduled",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/jobs/sync-matches?mode=live",
      "schedule": "0 16-22 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
